  "components": {
    "schemas": {
      "Actor": {
        "required": [
          "biography",
          "birthDate",
          "country",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "firstName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "country": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "biography": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "movieActors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovieActor"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginModel": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Movie": {
        "required": [
          "description",
          "durationMinutes",
          "genre",
          "releaseDate",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "genre": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "releaseDate": {
            "type": "string",
            "format": "date"
          },
          "durationMinutes": {
            "maximum": 600,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "movieActors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovieActor"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MovieActor": {
        "required": [
          "actorId",
          "movieId"
        ],
        "type": "object",
        "properties": {
          "movieId": {
            "type": "integer",
            "format": "int32"
          },
          "movie": {
            "$ref": "#/components/schemas/Movie"
          },
          "actorId": {
            "type": "integer",
            "format": "int32"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "roleName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "billingOrder": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
