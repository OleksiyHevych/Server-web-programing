{
  "Jwt": {
    "Issuer": "pm.auth",
    "Audience": "pm.clients",
    "Key": "SUPER_SECRET_DEMO_KEY_CHANGE_ME_32CHARS_MIN"
  },
  "ReverseProxy": {
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7100/" }
        }
      },
      "actors": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7101/" }
        }
      },
      "movies": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7102/" }
        }
      },
      "movie-actors": {
        "Destinations": {
          "d1": { "Address": "http://localhost:7103/" }
        }
      }
    },
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "actors": {
        "ClusterId": "actors",
        "Match": { "Path": "/api/actors/{**catch-all}" }
      },
      "movies": {
        "ClusterId": "movies",
        "Match": { "Path": "/api/movies/{**catch-all}" }
      },
      "movie-actors": {
        "ClusterId": "movie-actors",
        "Match": { "Path": "/api/movie-actors/{**catch-all}" }
      },

      "auth-swagger": {
        "ClusterId": "auth",
        "Match": { "Path": "/_swagger/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/_swagger/auth" },
          { "PathPrefix": "/swagger" }
        ]
      },
      "actors-swagger": {
        "ClusterId": "actors",
        "Match": { "Path": "/_swagger/actors/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/_swagger/actors" },
          { "PathPrefix": "/swagger" }
        ]
      },
      "movies-swagger": {
        "ClusterId": "movies",
        "Match": { "Path": "/_swagger/movies/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/_swagger/movies" },
          { "PathPrefix": "/swagger" }
        ]
      },
      "movie-actors-swagger": {
        "ClusterId": "movie-actors",
        "Match": { "Path": "/_swagger/movie-actors/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/_swagger/movie-actors" },
          { "PathPrefix": "/swagger" }
        ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
